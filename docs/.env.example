# ============================================================================
# FreeLib — Környezeti változók és konfigurációs paraméterek (.env.example)
# ============================================================================
# Ez a fájl dokumentálja az alkalmazás fordítási (build-time) és futásidejű
# konfigurációs változóit. A Flutter --dart-define-from-file=.env kapcsolóval
# vagy a rendszer környezeti változóiként használhatók.

# ── 1. Külső Könyv API Beállítások (Opcionális) ─────────────────────────────
# Google Books API kulcs. Ha üres vagy nincs megadva, az alkalmazás a nyilvános
# (kulcs nélküli) kvótát használja.
GOOGLE_BOOKS_API_KEY=

# Hálózati kérések alapértelmezett időkorlátja másodpercben (Default: 5)
API_CONNECT_TIMEOUT_SECONDS=5
API_RECEIVE_TIMEOUT_SECONDS=5

# Moly.hu magyar fallback kereső időkorlátja másodpercben (Default: 6)
MOLY_FALLBACK_TIMEOUT_SECONDS=6

# Open Library közösségi értékelés lekérdezési időkorlátja másodpercben (Default: 2)
OPEN_LIBRARY_RATINGS_TIMEOUT_SECONDS=2

# ── 2. Adatbázis és Titkosítási Beállítások (Belső alapértékek) ─────────────
# Helyi SQLite adatbázis fájlneve az izolált ApplicationDocumentsDirectory-ban
FREELIB_DB_FILENAME=freelib.db

# 256 bites ChaCha20-MAC kulcsfájl neve az izolált ApplicationSupportDirectory-ban
FREELIB_VAULT_KEY_FILENAME=.freelib_vault.key

# Alapértelmezett éves olvasási kihívás cél (könyv / év, Default: 12)
DEFAULT_YEARLY_READING_GOAL=12

# ── 3. Build és Fejlesztői Környezet (Android / Gradle) ─────────────────────
# Java 17 futtatókörnyezet útvonala a Gradle számára
JAVA_HOME=C:/Program Files/Android/Android Studio/jbr

# Android SDK gyökérkönyvtár
ANDROID_HOME=C:/Users/marti/AppData/Local/Android/Sdk

